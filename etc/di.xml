<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Csp\Model\CompositePolicyCollector">
        <arguments>
            <argument name="collectors" xsi:type="array">
                <item name="faccelerate_custom_host" xsi:type="object" sortOrder="50">Faccelerate\Connect\Model\Csp\CustomHostCollector\Proxy</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="faccelerate_connect" xsi:type="object">Faccelerate\Connect\Console\Command\ConnectCommand</item>
                <item name="faccelerate_status" xsi:type="object">Faccelerate\Connect\Console\Command\StatusCommand</item>
                <item name="faccelerate_disconnect" xsi:type="object">Faccelerate\Connect\Console\Command\DisconnectCommand</item>
            </argument>
        </arguments>
    </type>
    <type name="Faccelerate\Connect\Console\Command\ConnectCommand">
        <arguments>
            <argument name="connectService" xsi:type="object">Faccelerate\Connect\Model\Connection\ConnectService\Proxy</argument>
            <argument name="backendUrl" xsi:type="object">Magento\Backend\Model\UrlInterface\Proxy</argument>
        </arguments>
    </type>
    <type name="Faccelerate\Connect\Console\Command\StatusCommand">
        <arguments>
            <argument name="connectService" xsi:type="object">Faccelerate\Connect\Model\Connection\ConnectService\Proxy</argument>
        </arguments>
    </type>
    <type name="Faccelerate\Connect\Console\Command\DisconnectCommand">
        <arguments>
            <argument name="connectService" xsi:type="object">Faccelerate\Connect\Model\Connection\ConnectService\Proxy</argument>
        </arguments>
    </type>
</config>
