# PHPStan for CI: run it with the phpstan binary of a Magento root that has this module installed
# (vendor/phpstan/phpstan, so %rootDir%/../.. is that root's vendor folder).
# bitexpert/phpstan-magento teaches PHPStan about generated classes and proxies.
includes:
    - %rootDir%/../../bitexpert/phpstan-magento/extension.neon

parameters:
    level: 5
    paths:
        - Block
        - Console
        - Controller
        - Model
        - Setup
