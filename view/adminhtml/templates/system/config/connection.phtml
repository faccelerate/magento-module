<?php
/**
 * @var \Faccelerate\Connect\Block\Adminhtml\System\Config\Connection $block
 * @var \Magento\Framework\Escaper $escaper
 */
$block->handleReturn();
$status = $block->getStatus();
$isConnected = $status === \Faccelerate\Connect\Model\Config::STATUS_CONNECTED;
$isPending = $status === \Faccelerate\Connect\Model\Config::STATUS_PENDING;
$connectUrl = $block->getConnectUrl();
?>
<div class="faccelerate-connection-panel">
    <?php if ($block->getError()): ?>
        <div class="message message-error"><?= $escaper->escapeHtml($block->getError()) ?></div>
    <?php endif; ?>

    <p>
        <strong><?= $escaper->escapeHtml(__('Status')) ?>:</strong>
        <?= $escaper->escapeHtml($block->getStatusLabel()) ?>
    </p>
    <p>
        <strong><?= $escaper->escapeHtml(__('Faccelerate API')) ?>:</strong>
        <?= $escaper->escapeHtml($block->getApiBaseUrl()) ?>
    </p>

    <?php if ($isPending && $connectUrl): ?>
        <p>
            <a href="<?= $escaper->escapeUrl($connectUrl) ?>" class="action-default">
                <?= $escaper->escapeHtml(__('Continue in Faccelerate')) ?>
            </a>
        </p>
    <?php endif; ?>

    <?php if (!$isConnected): ?>
        <a href="<?= $escaper->escapeUrl($block->getConfirmUrl('connect')) ?>" class="action-default primary">
            <?= $escaper->escapeHtml($isPending ? __('Start again') : __('Connect to Faccelerate')) ?>
        </a>
    <?php endif; ?>

    <?php if ($status !== \Faccelerate\Connect\Model\Config::STATUS_NONE): ?>
        <a href="<?= $escaper->escapeUrl($block->getConfirmUrl('refresh')) ?>" class="action-default">
            <?= $escaper->escapeHtml(__('Check status')) ?>
        </a>
        <a href="<?= $escaper->escapeUrl($block->getConfirmUrl('disconnect')) ?>" class="action-default">
            <?= $escaper->escapeHtml(__('Disconnect')) ?>
        </a>
    <?php endif; ?>
</div>
